# Copia este fichero a .env y cambia los valores. .env nunca se commitea (C-15).

# Postgres local (docker compose). La contraseña de DATABASE_URL debe coincidir con POSTGRES_PASSWORD.
POSTGRES_USER=todo
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=todo

# API
DATABASE_URL=postgresql://todo:cambia-esta-contrasena@localhost:5432/todo
PORT=3000
NODE_ENV=development
